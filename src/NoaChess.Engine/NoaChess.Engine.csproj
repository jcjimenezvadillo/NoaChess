<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NoaChess.Core\NoaChess.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- SkipLocalsInit needs it. No unsafe code is written: the attribute only
         tells the JIT not to zero a method's stack buffers, and it is applied
         to the few hot methods whose stackalloc'd spans are fully written
         before they are read (see NnueInference and StaticExchangeEvaluator). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>


  <!-- Release builds carry no debug symbols: published engine folders stay
       clean (one exe) and distributed stack traces just lose line numbers.
       Debug builds keep full symbols for development. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

</Project>
