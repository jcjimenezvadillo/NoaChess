<Window x:Class="NoaChess.GUI.Wpf.Views.PositionEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NoaChess.GUI.Wpf.ViewModels"
        Title="Set up a position"
        Width="900" Height="716"
        MinWidth="820" MinHeight="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource AppBackground}">
    <!-- Pick a piece from the rack, then click the squares. The right button
         clears a square. The FEN box works both ways: it shows what has been
         built and it loads whatever is pasted into it. -->

    <Window.Resources>
        <!-- The editor board is deliberately plainer than the playing one: no
             move hints, no highlights, nothing that suggests a game. -->
        <DataTemplate x:Key="EditorSquare" DataType="{x:Type vm:SquareViewModel}">
            <Grid>
                <Rectangle Fill="{Binding BaseBrush}"/>
                <TextBlock Text="{Binding RankLabel}" Foreground="{Binding LabelBrush}"
                           FontSize="11" FontWeight="Bold"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Margin="3,1,0,0"/>
                <TextBlock Text="{Binding FileLabel}" Foreground="{Binding LabelBrush}"
                           FontSize="11" FontWeight="Bold"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,3,1"/>
                <Image Source="{Binding PieceImage}" Margin="4"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="StampTemplate" DataType="{x:Type vm:PieceStamp}">
            <Button Width="48" Height="48" Margin="0,0,6,6"
                    Click="OnStampClicked" Tag="{Binding}">
                <Grid>
                    <Image Source="{Binding Image}" Margin="4"/>
                    <TextBlock Text="clear" FontSize="11" VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}"
                               Visibility="{Binding IsEraser, Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
                        <Setter Property="Padding" Value="2"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentWash}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <DockPanel Margin="18">

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancel" Style="{StaticResource ToolButton}" Padding="22,6"
                            IsCancel="True" Margin="0,0,8,0"/>
                    <Button x:Name="AcceptButton" Content="Use this position"
                            Style="{StaticResource AccentButton}" Padding="22,6"
                            IsDefault="True" Click="OnAcceptClicked"
                            IsEnabled="{Binding IsValid}"/>
                </StackPanel>
                <TextBlock Text="{Binding Problem}" Foreground="{StaticResource Negative}"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- Right column: the rack and the options -->
        <StackPanel DockPanel.Dock="Right" Width="344" Margin="18,0,0,0">

            <TextBlock Text="PIECES" Style="{StaticResource SectionHeader}" FontSize="12"/>
            <TextBlock Text="Pick one, then click the squares. The right button clears a square."
                       Foreground="{StaticResource TextMuted}" FontSize="11.5"
                       TextWrapping="Wrap" Margin="0,2,0,8"/>

            <ItemsControl ItemsSource="{Binding WhitePalette}" ItemTemplate="{StaticResource StampTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <ItemsControl ItemsSource="{Binding BlackPalette}" ItemTemplate="{StaticResource StampTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <ContentControl Content="{Binding Eraser}" ContentTemplate="{StaticResource StampTemplate}"
                            HorizontalAlignment="Left"/>

            <Rectangle Height="1" Fill="{StaticResource BorderSoft}" Margin="0,10,0,12"/>

            <TextBlock Text="SIDE TO MOVE" Style="{StaticResource SectionHeader}" FontSize="12"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button Content="White" Width="100" Height="34" Click="OnWhiteToMoveClicked">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WhiteToMove}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentWash}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Black" Width="100" Height="34" Margin="8,0,0,0" Click="OnBlackToMoveClicked">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BlackToMove}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentWash}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <TextBlock Text="CASTLING" Style="{StaticResource SectionHeader}" FontSize="12" Margin="0,14,0,0"/>
            <TextBlock Text="Rights are kept only while the king and that rook are still at home."
                       Foreground="{StaticResource TextMuted}" FontSize="11.5"
                       TextWrapping="Wrap" Margin="0,2,0,6"/>
            <UniformGrid Columns="2">
                <CheckBox Content="White O-O" IsChecked="{Binding WhiteKingSide}" Margin="0,3"/>
                <CheckBox Content="White O-O-O" IsChecked="{Binding WhiteQueenSide}" Margin="0,3"/>
                <CheckBox Content="Black O-O" IsChecked="{Binding BlackKingSide}" Margin="0,3"/>
                <CheckBox Content="Black O-O-O" IsChecked="{Binding BlackQueenSide}" Margin="0,3"/>
            </UniformGrid>

            <TextBlock Text="FEN" Style="{StaticResource SectionHeader}" FontSize="12" Margin="0,14,0,0"/>
            <TextBox Text="{Binding Fen, UpdateSourceTrigger=LostFocus}" Margin="0,6,0,0"
                     FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                     TextWrapping="Wrap" AcceptsReturn="False" Height="58"/>
        </StackPanel>

        <!-- The board -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Starting position" Style="{StaticResource ToolButton}"
                        Click="OnStartPositionClicked"/>
                <Button Content="Empty board" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                        Click="OnClearClicked"/>
                <Button Content="Flip" Style="{StaticResource ToolButton}" Margin="8,0,0,0"
                        Click="OnFlipClicked"/>
            </StackPanel>

            <Viewbox Stretch="Uniform">
                <Border CornerRadius="3" ClipToBounds="True"
                        BorderBrush="{StaticResource BorderStrong}" BorderThickness="1">
                    <Grid x:Name="EditorSurface" Width="480" Height="480" Background="Transparent"
                          MouseLeftButtonDown="OnBoardLeftClick"
                          MouseRightButtonDown="OnBoardRightClick">
                        <ItemsControl ItemsSource="{Binding DisplaySquares}"
                                      ItemTemplate="{StaticResource EditorSquare}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="8" Columns="8"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Viewbox>
        </DockPanel>
    </DockPanel>
</Window>
