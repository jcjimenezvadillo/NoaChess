<Window x:Class="NoaChess.GUI.Wpf.Views.PromotionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Promotion"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Background="{StaticResource AppBackground}">
    <!-- Four pieces to choose from, filled in from code-behind with the colour
         of the promoting pawn. The queen is first and is the default, because
         it is the answer more than nineteen times out of twenty. -->
    <StackPanel Margin="16,12,16,14">
        <TextBlock Text="PROMOTE TO" Style="{StaticResource SectionHeader}" Margin="2,0,0,8"/>
        <StackPanel Orientation="Horizontal">
            <StackPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource ToolButton}">
                    <Setter Property="Width" Value="76"/>
                    <Setter Property="Height" Value="76"/>
                    <Setter Property="Margin" Value="3"/>
                    <Setter Property="Padding" Value="6"/>
                </Style>
            </StackPanel.Resources>
            <Button Click="OnQueenClicked" IsDefault="True">
                <Image x:Name="QueenImage"/>
            </Button>
            <Button Click="OnRookClicked">
                <Image x:Name="RookImage"/>
            </Button>
            <Button Click="OnBishopClicked">
                <Image x:Name="BishopImage"/>
            </Button>
            <Button Click="OnKnightClicked">
                <Image x:Name="KnightImage"/>
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
