<Window x:Class="NoaChess.GUI.Wpf.Views.EnginesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NoaChess.GUI.Wpf.ViewModels"
        Title="UCI engines"
        Width="640" Height="470"
        MinWidth="520" MinHeight="340"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource AppBackground}">
    <!-- The engines available to play a side. An engine is only added once it
         has actually answered "uciok", so this list holds programs that have
         proved they are engines rather than paths that might be. -->
    <DockPanel Margin="18">

        <Border DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="ENGINES" Style="{StaticResource SectionHeader}" FontSize="12"/>
                <TextBlock Text="Add a UCI engine and it can play either colour, including against NoaChess or against another engine."
                           Foreground="{StaticResource TextMuted}" FontSize="11.5"
                           TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left" Content="Add an engine..." Padding="16,6"
                    Style="{StaticResource AccentButton}" Click="OnAddClicked"/>
            <Button DockPanel.Dock="Left" Content="Remove" Padding="16,6" Margin="8,0,0,0"
                    Style="{StaticResource ToolButton}" Click="OnRemoveClicked"/>
            <Button DockPanel.Dock="Right" Content="Close" Padding="22,6"
                    Style="{StaticResource ToolButton}" IsCancel="True" IsDefault="True"
                    HorizontalAlignment="Right"/>
            <TextBlock x:Name="StatusLine" VerticalAlignment="Center" Margin="12,0"
                       TextWrapping="Wrap" FontSize="11.5"
                       Foreground="{StaticResource TextMuted}"/>
        </DockPanel>

        <Border Style="{StaticResource Card}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                <ItemsControl x:Name="EngineList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:EngineEntry}">
                            <Border x:Name="Row" CornerRadius="3" Padding="8,6" Margin="0,1"
                                    Background="Transparent" Cursor="Hand"
                                    MouseLeftButtonDown="OnRowClicked">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"/>
                                    <TextBlock Text="{Binding Path}" FontSize="11"
                                               Foreground="{StaticResource TextMuted}"
                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                    <TextBlock Text="the file is no longer there" FontSize="11"
                                               Foreground="{StaticResource Negative}" Margin="0,1,0,0"
                                               Visibility="{Binding IsMissing, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background"
                                            Value="{StaticResource PanelHover}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Row" Property="Background"
                                            Value="{StaticResource AccentWash}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
