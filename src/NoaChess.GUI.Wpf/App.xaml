<Application x:Class="NoaChess.GUI.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:theme="clr-namespace:NoaChess.GUI.Wpf.Theme"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters live at application scope: the main window, the move
                 list and both dialogs all need the same handful. -->
            <theme:NullToVisibilityConverter x:Key="NullToVis"/>
            <theme:EqualityToBoolConverter x:Key="EqualsParam"/>
            <theme:InverseBooleanConverter x:Key="Not"/>
            <theme:FractionToStarConverter x:Key="Bar"/>
            <theme:FractionToStarConverter x:Key="BarRest" Invert="True"/>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <theme:ScoreToBrushConverter x:Key="ScoreBrush"
                                         Positive="{StaticResource Positive}"
                                         Negative="{StaticResource Negative}"
                                         Neutral="{StaticResource TextPrimary}"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
