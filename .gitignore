## A streamlined .gitignore for modern .NET projects
## including temporary files, build results, and
## files generated by popular .NET tools. If you are
## developing with Visual Studio, the VS .gitignore
## https://github.com/github/gitignore/blob/main/VisualStudio.gitignore
## has more thorough IDE-specific entries.
##
## Get latest from https://github.com/github/gitignore/blob/main/Dotnet.gitignore

# .NET Build Artifacts
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# .NET Core and Dependencies
project.lock.json
project.fragment.lock.json
artifacts/

# NuGet Packages
*.nupkg
*.snupkg

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Build Logs and Diagnostics
*.binlog
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
CodeCoverage/

# Test Result Files
*.VisualState.xml
TestResult.xml
nunit-*.xml

# IDE and Editor Configuration - Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# IDE and Editor Configuration - VS Code
.vscode/

# IDE and Editor Configuration - Rider / JetBrains
.idea/
.claude

# Environment and Configuration
.env
.env.*

# Python Generated Files (tools/training/nnue scripts)
/tools/training/nnue/__pycache__/
/tools/training/nnue/__pycache__/*.pyc

# NNUE Training Data and Models (regenerable via tools/NoaChess.DataGen)
data/
/models/nnue/
tools/training/nnue/checkpoints/

# Embedded NNUE net: derived from models/nnue via the pipeline, regenerated
# every run; the csproj embeds it only when present (Exists condition).
/src/NoaChess.UCI/Resources/noa-embedded.noannue

# Legacy training scripts
/overnight_training_nnue_run4.bat
/overnight_training.bat

# Generic temporary files
~$*
*~
